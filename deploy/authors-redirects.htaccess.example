RewriteRule ^authors/author-5/?$ /authors/cristina-tudose/ [R=301,L,NE]
RewriteRule ^authors/author-6/?$ /authors/dominic-field/ [R=301,L,NE]
RewriteRule ^authors/author-7/?$ /authors/jon-pill/ [R=301,L,NE]
