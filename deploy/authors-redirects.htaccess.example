# Example Apache .htaccess redirects. Enable mod_rewrite before using.
RewriteEngine On
RewriteRule ^authors/author-1/?$ /authors/corey-levitan/ [R=301,L,NE]
RewriteRule ^authors/author-2/?$ /authors/dan-michalski/ [R=301,L,NE]
RewriteRule ^authors/author-3/?$ /authors/marco-ibarra/ [R=301,L,NE]
